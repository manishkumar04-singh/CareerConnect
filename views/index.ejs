<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CareerConnect | Find Jobs & Internships</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- ==================== NAVBAR ==================== -->

    <%- include('./partials/navbar') %>


    <!-- ==================== HERO SECTION ==================== -->

    <main>

        <section class="hero">

            <div class="container hero-container">

                <div class="hero-content">

                    <div class="hero-badge">
                        🚀 Your Career Starts Here
                    </div>

                    <h1>
                        Find Your Next
                        <span>Opportunity.</span>
                    </h1>

                    <p class="hero-description">
                        Discover internships and job opportunities,
                        build your professional profile, and take the
                        next step towards your career.
                    </p>

                    <div class="hero-buttons">

                        <a href="#jobs" class="primary-btn">
                            Find Jobs
                            <span>→</span>
                        </a>

                        <a href="#jobs" class="secondary-btn">
                            Explore Internships
                        </a>

                    </div>

                </div>


                <div class="hero-visual">

                    <div class="hero-card main-card">

                        <div class="card-top">

                            <div class="company-logo">
                                TC
                            </div>

                            <div>
                                <h3>Frontend Developer</h3>
                                <p>Tech Company</p>
                            </div>

                            <span class="bookmark">♡</span>

                        </div>

                        <div class="job-details">

                            <span>📍 Remote</span>
                            <span>💼 Full Time</span>

                        </div>

                        <div class="job-footer">

                            <strong>₹6 - 10 LPA</strong>

                            <span>2 days ago</span>

                        </div>

                    </div>


                    <div class="floating-card students-card">

                        <div class="floating-icon">
                            ✓
                        </div>

                        <div>
                            <strong>5,000+</strong>
                            <p>Opportunities</p>
                        </div>

                    </div>


                    <div class="floating-card companies-card">

                        <div class="company-mini-logo">
                            ★
                        </div>

                        <div>
                            <strong>Top Companies</strong>
                            <p>Hiring Now</p>
                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- ==================== SEARCH SECTION ==================== -->

        <section class="search-section">

            <div class="container">

                <div class="search-box">

                    <div class="search-field">

                        <span class="search-icon">⌕</span>

                        <div>
                            <label>Search</label>

                            <input
                                type="text"
                                placeholder="Job title, skill or company"
                            >
                        </div>

                    </div>


                    <div class="search-divider"></div>


                    <div class="search-field">

                        <span class="search-icon">⌖</span>

                        <div>
                            <label>Location</label>

                            <input
                                type="text"
                                placeholder="City or Remote"
                            >
                        </div>

                    </div>


                    <button class="search-btn">
                        Search Jobs
                    </button>

                </div>

            </div>

        </section>


        <!-- ==================== FEATURED JOBS ==================== -->

        <section class="jobs-section" id="jobs">

            <div class="container">

                <div class="section-heading">

                    <div>
                        <span class="section-label">
                            OPPORTUNITIES
                        </span>

                        <h2>
                            Featured Jobs & Internships
                        </h2>
                    </div>

                    <a href="#" class="view-all">
                        View All →
                    </a>

                </div>


                <div class="jobs-grid">


                    <!-- JOB CARD 1 -->

                    <article class="job-card">

                        <div class="job-card-header">

                            <div class="company-logo blue">
                                G
                            </div>

                            <button class="save-job">
                                ♡
                            </button>

                        </div>

                        <span class="job-type internship">
                            Internship
                        </span>

                        <h3>Frontend Developer Intern</h3>

                        <p class="company-name">
                            Growth Technologies
                        </p>

                        <div class="job-meta">

                            <span>📍 Kolkata</span>
                            <span>⏱ 3 Months</span>

                        </div>

                        <div class="job-card-footer">

                            <strong>₹15K / month</strong>

                            <a href="#">
                                Apply →
                            </a>

                        </div>

                    </article>


                    <!-- JOB CARD 2 -->

                    <article class="job-card">

                        <div class="job-card-header">

                            <div class="company-logo purple">
                                A
                            </div>

                            <button class="save-job">
                                ♡
                            </button>

                        </div>

                        <span class="job-type full-time">
                            Full Time
                        </span>

                        <h3>Software Engineer</h3>

                        <p class="company-name">
                            Alpha Systems
                        </p>

                        <div class="job-meta">

                            <span>📍 Bengaluru</span>
                            <span>💼 Hybrid</span>

                        </div>

                        <div class="job-card-footer">

                            <strong>₹8 - 12 LPA</strong>

                            <a href="#">
                                Apply →
                            </a>

                        </div>

                    </article>


                    <!-- JOB CARD 3 -->

                    <article class="job-card">

                        <div class="job-card-header">

                            <div class="company-logo orange">
                                D
                            </div>

                            <button class="save-job">
                                ♡
                            </button>

                        </div>

                        <span class="job-type internship">
                            Internship
                        </span>

                        <h3>Backend Developer Intern</h3>

                        <p class="company-name">
                            DevLabs
                        </p>

                        <div class="job-meta">

                            <span>📍 Pune</span>
                            <span>⏱ 6 Months</span>

                        </div>

                        <div class="job-card-footer">

                            <strong>₹20K / month</strong>

                            <a href="#">
                                Apply →
                            </a>

                        </div>

                    </article>

                </div>

            </div>

        </section>


        <!-- ==================== WHY CAREERCONNECT ==================== -->

        <section class="features-section" id="about">

            <div class="container">

                <div class="center-heading">

                    <span class="section-label">
                        WHY CAREERCONNECT
                    </span>

                    <h2>
                        Everything You Need to Build Your Career
                    </h2>

                    <p>
                        One platform to discover opportunities,
                        showcase your skills, and manage your
                        career journey.
                    </p>

                </div>


                <div class="features-grid">


                    <div class="feature-card">

                        <div class="feature-icon blue-icon">
                            🔎
                        </div>

                        <h3>Discover Opportunities</h3>

                        <p>
                            Find relevant jobs and internships
                            based on your skills and interests.
                        </p>

                    </div>


                    <div class="feature-card">

                        <div class="feature-icon purple-icon">
                            👤
                        </div>

                        <h3>Build Your Profile</h3>

                        <p>
                            Showcase your skills, projects,
                            education and experience to recruiters.
                        </p>

                    </div>


                    <div class="feature-card">

                        <div class="feature-icon green-icon">
                            📊
                        </div>

                        <h3>Track Applications</h3>

                        <p>
                            Keep track of every application and
                            know exactly where you stand.
                        </p>

                    </div>


                </div>

            </div>

        </section>


        <!-- ==================== HOW IT WORKS ==================== -->

        <section class="how-section" id="how-it-works">

            <div class="container">

                <div class="center-heading">

                    <span class="section-label">
                        SIMPLE PROCESS
                    </span>

                    <h2>
                        How CareerConnect Works
                    </h2>

                </div>


                <div class="steps-container">


                    <div class="step">

                        <div class="step-number">
                            01
                        </div>

                        <h3>Create Your Profile</h3>

                        <p>
                            Add your education, skills,
                            projects and experience.
                        </p>

                    </div>


                    <div class="step-line"></div>


                    <div class="step">

                        <div class="step-number">
                            02
                        </div>

                        <h3>Find Opportunities</h3>

                        <p>
                            Search and discover jobs and
                            internships that match your goals.
                        </p>

                    </div>


                    <div class="step-line"></div>


                    <div class="step">

                        <div class="step-number">
                            03
                        </div>

                        <h3>Apply & Track</h3>

                        <p>
                            Apply to opportunities and
                            track your applications.
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- ==================== RECRUITER CTA ==================== -->

        <section class="recruiter-section">

            <div class="container">

                <div class="recruiter-box">

                    <div>

                        <span class="section-label light">
                            FOR RECRUITERS
                        </span>

                        <h2>
                            Looking for talented people?
                        </h2>

                        <p>
                            Connect with skilled students and
                            discover your next great hire.
                        </p>

                    </div>

                    <a href="#" class="recruiter-btn">
                        Post an Opportunity →
                    </a>

                </div>

            </div>

        </section>

    </main>


    <!-- ==================== FOOTER ==================== -->

    <%- include('./partials/footer') %>
    ß

</body>
</html>