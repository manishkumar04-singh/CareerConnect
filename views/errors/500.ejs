<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Something Went Wrong | CareerConnect</title>

    <link rel="stylesheet" href="/css/error-pages.css">
</head>

<body>

    <main class="error-page">

        <div class="error-card">

            <div class="brand">
                <div class="brand-icon">C</div>
                <span>CareerConnect</span>
            </div>

            <div class="error-icon server-error">
                ⚠
            </div>

            <span class="error-code">
                500
            </span>

            <h1>Something Went Wrong</h1>

            <p class="error-message">
                We couldn't complete your request because of an unexpected server error.
            </p>

            <p class="error-help">
                Please try again in a moment. If the problem continues, return to the home page.
            </p>

            <div class="error-actions">

                <button
                    type="button"
                    class="secondary-button refresh-button"
                    onclick="window.location.reload()">

                    ↻ Try Again

                </button>

                <a href="/" class="primary-button">
                    Go to Home
                </a>

            </div>

        </div>

    </main>

</body>

</html>