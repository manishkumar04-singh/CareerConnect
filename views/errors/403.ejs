<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Access Denied | CareerConnect</title>

    <link rel="stylesheet" href="/css/error-pages.css">
</head>

<body>

    <main class="error-page">

        <div class="error-card">

            <div class="brand">
                <div class="brand-icon">C</div>
                <span>CareerConnect</span>
            </div>

            <div class="error-icon danger">
                🔒
            </div>

            <span class="error-code">
                403
            </span>

            <h1>Access Denied</h1>

            <p class="error-message">
                You do not have permission to access this page or perform this action.
            </p>

            <p class="error-help">
                Please return to your dashboard or use an account with the required access.
            </p>

            <div class="error-actions">

                <a href="javascript:history.back()" class="secondary-button">
                    ← Go Back
                </a>

                <a href="/" class="primary-button">
                    Go to Home
                </a>

            </div>

        </div>

    </main>

</body>

</html>