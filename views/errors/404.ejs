<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Page Not Found | CareerConnect</title>
    <link rel="icon" type="image/png" href="/images/careerconnect-icon.png">

    <link rel="stylesheet" href="/css/error-pages.css">
</head>

<body>

    <main class="error-page">

        <div class="error-card">

            <div class="brand">
                <div class="brand-icon">C</div>
                <span>CareerConnect</span>
            </div>

            <div class="error-icon">
                🔎
            </div>

            <span class="error-code">
                404
            </span>

            <h1>Page Not Found</h1>

            <p class="error-message">
                The page or resource you're looking for could not be found.
            </p>

            <p class="error-help">
                It may have been moved, deleted, or the address may be incorrect.
            </p>

            <div class="error-actions">

                <a href="javascript:history.back()" class="secondary-button">
                    ← Go Back
                </a>

                <a href="/" class="primary-button">
                    Go to Home
                </a>

            </div>

        </div>

    </main>

</body>

</html>