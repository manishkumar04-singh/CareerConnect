<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Change Password | CareerConnect</title>
    <link rel="icon" type="image/png" href="/images/careerconnect-icon.png">

    <link rel="stylesheet" href="/css/student-change-password.css">
</head>

<body>

    <div class="dashboard">

        <aside class="sidebar">

            <div class="logo">
                <div class="logo-icon">C</div>
                <span>CareerConnect</span>
            </div>

            <div class="menu-section">

                <p class="menu-title">MAIN MENU</p>

                <a href="/student-dashboard" class="menu-item">
                    <span>⌂</span>
                    <span>Dashboard</span>
                </a>

                <a href="/student-jobs" class="menu-item">
                    <span>⌕</span>
                    <span>Find Jobs</span>
                </a>

                <a href="/student/application" class="menu-item">
                    <span>▣</span>
                    <span>My Applications</span>
                </a>

                <a href="/student-saved-jobs" class="menu-item">
                    <span>☆</span>
                    <span>Saved Jobs</span>
                </a>

                <p class="menu-title second-title">ACCOUNT</p>

                <a href="/student/profile" class="menu-item">
                    <span>◯</span>
                    <span>My Profile</span>
                </a>

                <a href="/student/settings" class="menu-item active">
                    <span>⚙</span>
                    <span>Settings</span>
                </a>

            </div>

            <div class="sidebar-bottom">

                <a href="/logout" class="menu-item logout">
                    <span>↪</span>
                    <span>Logout</span>
                </a>

            </div>

        </aside>


        <main class="main-content">

            <header class="topbar">

                <div>
                    <h1>Change Password</h1>
                    <p>Keep your CareerConnect account secure.</p>
                </div>

                <a href="/student/setting" class="back-button">
                    ← Back to Settings
                </a>

            </header>


            <section class="password-section">

                <div class="password-card">

                    <div class="card-heading">

                        <div class="heading-icon">
                            🔐
                        </div>

                        <div>
                            <h2>Update Password</h2>
                            <p>Enter your current password before choosing a new one.</p>
                        </div>

                    </div>


                    <form action="/student/change-password" method="POST">

                        <div class="form-group">

                            <label for="currentPassword">
                                Current Password
                            </label>

                            <input
                                type="password"
                                id="currentPassword"
                                name="currentPassword"
                                placeholder="Enter your current password"
                                required
                            >
                        <% if(typeof currentPass !== "undefined" && !currentPass){ %> 
                            <p class="password-error">Current Password is wrong.</p>
                        <% } %>
                        </div>


                        <div class="form-group">

                            <label for="newPassword">
                                New Password
                            </label>

                            <input
                                type="password"
                                id="newPassword"
                                name="newPassword"
                                placeholder="Enter your new password"
                                required
                            >

                            <span class="input-help">
                                Use a strong password that you don't use elsewhere.
                            </span>

                        </div>


                        <div class="form-group">

                            <label for="confirmPassword">
                                Confirm New Password
                            </label>

                            <input
                                type="password"
                                id="confirmPassword"
                                name="confirmPassword"
                                placeholder="Re-enter your new password"
                                required
                            >
                        <% if(typeof passConfirm !== "undefined" && !passConfirm){ %>    
                            <p class="password-error">New Password and Confirm Password Doesn't Match.</p>
                        <% } %>
                        </div>


                        <button type="submit" class="update-button">
                            Update Password
                        </button>

                    </form>


                    <div class="divider">
                        <span>OR</span>
                    </div>


                    <div class="forgot-section">

                        <div>

                            <h3>Forgot your current password?</h3>

                            <p>
                                Verify your registered email using an OTP
                                and create a new password.
                            </p>

                        </div>

                        <button type="button" class="otp-button" id="openOtpModal">
                            Verify with Email OTP →
                        </button>

                    </div>

                </div>


                <div class="security-note">

                    <div class="security-note-icon">
                        🛡
                    </div>

                    <div>

                        <h3>Password Security</h3>

                        <p>
                            Never share your password or OTP with anyone.
                            CareerConnect will never ask for your password by email.
                        </p>

                    </div>

                </div>

            </section>

        </main>

    </div>
    
    <!-- ================= EMAIL OTP MODAL ================= -->
    
    <div class="otp-modal-overlay" id="otpModal">
    
        <div class="otp-modal">
    
            <button class="otp-modal-close" id="closeOtpModal">
                ×
            </button>
    
            <div class="otp-modal-icon">
                ✉
            </div>
    
            <h2>Verify Your Email</h2>
    
            <p class="otp-modal-text">
                We'll send a verification code to your registered email address.
            </p>
    
            <div class="registered-email-box">
    
                <span>Registered Email</span>
                
                <strong>
                    <%= email %>
                </strong>
    
            </div>
            <% if(typeof otpSended !== "undefined" && !otpSended) { %>
                <p class="forgot-message"><%= otpSendedMsg %></p>
            <% } %>
            <form action="/student/send-password-otp" method="POST">
    
                <button type="submit" class="send-otp-button">
                    Send OTP
                </button>
    
            </form>
    
            <button class="cancel-otp-button" id="cancelOtpModal">
                Cancel
            </button>
    
        </div>
        
        <!-- ================= VERIFY OTP MODAL ================= -->
        
        <div class="verify-password-otp-box">
        
            <button type="button" class="otp-modal-close" id="closeVerifyOtpModal">
                ×
            </button>
        
            <div class="otp-modal-icon">
                🔐
            </div>
        
            <h2>Verify OTP</h2>
        
            <p class="otp-modal-text">
                Enter the 5-digit verification code sent to your registered email address.
            </p>
        
        
            <div class="registered-email-box">
        
                <span>Verification code sent to</span>
        
                <strong>
                    <%= email %>
                </strong>
        
            </div>
        
        
            <!-- SPACE FOR OTP ERROR -->
        
            <p class="verify-otp-message"></p>
        
        
            <form action="/student/change-password/verify-otp" method="POST">
        
                <div class="verify-otp-input">
        
                    <label for="passwordOtp">
                        Verification Code
                    </label>
        
                    <input type="text" id="passwordOtp" name="otp" maxlength="5" placeholder="Enter 5-digit OTP" required>
        
                </div>

                <% if(typeof otpVerified !== "undefined" && !otpVerified) { %>
                    <p class="forgot-message"><%= otpVerifiedMsg %></p>
                <% } %>    
        
        
                <button type="submit" class="send-otp-button">
                    Verify OTP
                </button>
        
            </form>
        
        
            <div class="verify-otp-bottom">
        
                <span>Didn't receive the code?</span>
        
                <form action="/student/send-password-otp" method="POST">
        
                    <button type="submit" class="resend-password-otp">
                        Resend OTP
                    </button>
        
                </form>
        
            </div>
        
        </div>
        
        <!-- ================= RESET PASSWORD MODAL ================= -->
        
        <div class="reset-password-modal">
        
            <button type="button" class="otp-modal-close" id="closeResetPasswordModal">
                ×
            </button>
        
            <div class="otp-modal-icon">
                🔒
            </div>
        
            <h2>Create New Password</h2>
        
            <p class="otp-modal-text">
                Your email has been verified successfully.
                Create a new password for your CareerConnect account.
            </p>
        
            <div class="registered-email-box">
        
                <span>Verified Email</span>
        
                <strong>
                    <%= email %>
                </strong>
        
            </div>
        
            <form action="/student/change-password/reset-with-otp" method="POST">
        
                <div class="reset-form-group">
        
                    <label for="newPassword">
                        New Password
                    </label>
        
                    <input type="password" id="newPassword" name="newPassword" placeholder="Enter new password" required>
        
                </div>
        
        
                <div class="reset-form-group">
        
                    <label for="confirmPassword">
                        Confirm New Password
                    </label>
        
                    <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm new password"
                        required>
        
                </div>
        
                <!-- ERROR MESSAGE SPACE -->
                <% if(typeof confirmPass !== "undefined" && !confirmPass) { %>
                    <p class="reset-password-message"><%= confirmPassMsg %></p>
                <% } %>
                <button type="submit" class="send-otp-button">
                    Reset Password
                </button>
        
            </form>
        
        </div>

    </div>

    <% if(typeof otpSended !== "undefined" && !otpSended) { %>
        <script>
            document.getElementById("otpModal").classList.add("active");
        </script>
    <% } %>

    <% if(typeof otpSended !== "undefined" && otpSended) { %>
        <script>
            document.getElementById("otpModal").classList.add("active");
            document.querySelector(".otp-modal").classList.add("inactive")
            document.querySelector(".verify-password-otp-box").classList.add("active");
        </script>
    <% } %>

    <% if(typeof otpVerified !== "undefined" && !otpVerified) { %>
        <script>
            document.getElementById("otpModal").classList.add("active");
            document.querySelector(".otp-modal").classList.add("inactive")
            document.querySelector(".verify-password-otp-box").add("active");
        </script>
    <% } %>

    <% if(typeof otpVerified !== "undefined" && otpVerified) { %>
        <script>
            document.getElementById("otpModal").classList.add("active");
            document.querySelector(".otp-modal").classList.add("inactive")
            document.querySelector(".reset-password-modal").classList.add("active");
        </script>
    <% } %>

    <% if(typeof confirmPass !== "undefined" && !confirmPass) { %>
        <script>
            document.getElementById("otpModal").classList.add("active");
            document.querySelector(".otp-modal").classList.add("inactive")
            document.querySelector(".reset-password-modal").classList.add("active");
        </script>
    <% } %>
    <script>
        const model=document.getElementById("otpModal");
        const emailButton=document.querySelector(".otp-button");
        const closeBtn=document.querySelector(".otp-modal-close");
        const cancelBtn =document.querySelector(".cancel-otp-button");
        const resendBtn=document.querySelector(".resend-password-otp");
        emailButton.addEventListener("click",()=>{
            model.classList.add("active");
        })
        closeBtn.addEventListener("click",()=>{
            model.classList.romove("active");
        })
        cancelBtn.addEventListener("click",()=>{
            model.classList.romove("remove");
        })

        resendBtn.addEventListener("click",()=>{
            document.getElementById("otpModal").classList.add("active");
        })
    </script>
</body>


</html>