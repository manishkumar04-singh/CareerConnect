<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Login | CareerConnect</title>

    <!-- Main CSS -->
    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <!-- Authentication CSS -->
    <link
        rel="stylesheet"
        href="/css/auth.css"
    >

</head>

<body>

    <!-- ==================== NAVBAR ==================== -->

    <%- include("../partials/navbar") %>


    <!-- ==================== LOGIN SECTION ==================== -->

    <main class="auth-page">

        <div class="auth-container">


            <!-- LEFT SIDE -->

            <section class="auth-intro">

                <div class="auth-intro-content">

                    <div class="auth-brand">
                        Career<span>Connect</span>
                    </div>

                    <span class="auth-label">
                        WELCOME BACK
                    </span>

                    <h1>
                        Your next
                        <span>opportunity</span>
                        is waiting.
                    </h1>

                    <p>
                        Sign in to discover new opportunities,
                        manage your applications, and continue
                        building your career.
                    </p>


                    <div class="auth-benefits">

                        <div class="benefit-item">

                            <div class="benefit-icon">
                                ✓
                            </div>

                            <div>
                                <strong>
                                    Discover Opportunities
                                </strong>

                                <p>
                                    Find jobs and internships
                                    that match your skills.
                                </p>
                            </div>

                        </div>


                        <div class="benefit-item">

                            <div class="benefit-icon">
                                ✓
                            </div>

                            <div>
                                <strong>
                                    Track Applications
                                </strong>

                                <p>
                                    Manage your applications
                                    from one place.
                                </p>
                            </div>

                        </div>


                        <div class="benefit-item">

                            <div class="benefit-icon">
                                ✓
                            </div>

                            <div>
                                <strong>
                                    Build Your Career
                                </strong>

                                <p>
                                    Showcase your skills and
                                    experience to recruiters.
                                </p>
                            </div>

                        </div>

                    </div>

                </div>

            </section>


            <!-- RIGHT SIDE -->

            <section class="auth-form-section">

                <div class="auth-form-container">

                    <div class="form-heading">

                        <h2>
                            Welcome Back
                        </h2>

                        <p>
                            Sign in to your CareerConnect account
                        </p>

                    </div>

   
                    <!-- LOGIN FORM -->

                    <form
                        class="auth-form"
                        action="/login"
                        method="POST"
                    >


                        <!-- EMAIL -->

                        <div class="form-group">

                            <label for="email">
                                Email Address
                            </label>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="Enter your email"
                                autocomplete="email"
                                required
                            >

                        </div>


                        <!-- PASSWORD -->

                        <div class="form-group">

                            <div class="label-row">
                            
                                <label for="password">
                                    Password
                                </label>
                            
                                <button type="button" class="forgot-password-link" id="openForgotModal">
                            
                                    Forgot Password?
                            
                                </button>

                            </div>

                            <input
                                type="password"
                                id="password"
                                name="password"
                                placeholder="Enter your password"
                                autocomplete="current-password"
                                required
                            >

                        </div>


                        <!-- REMEMBER ME -->

                        <div class="remember-row">

                            <label class="checkbox-container">

                                <input
                                    type="checkbox"
                                    name="remember"
                                >

                                <span>
                                    Remember me
                                </span>

                            </label>

                        </div>


                        <!-- LOGIN BUTTON -->

                        <button
                            type="submit"
                            class="auth-submit-btn"
                        >
                            Sign In
                            <span>→</span>
                        </button>


                    </form>


                    <!-- REGISTER LINK -->

                    <div class="auth-switch">

                        <p>
                            Don't have an account?

                            <a href="/register">
                                Create an account
                            </a>
                        </p>
                    </div>
           
                    <% if(typeof registered !=="undefined" && !registered) { %>
                        <p class="forgot-message1">
                            <%= Msg %>
                        </p>
                    <% } %>
                    <!-- DIVIDER -->

                    <div class="auth-divider">

                        <span>
                            Secure Career Platform
                        </span>

                    </div>

                </div>

            </section>

        </div>

    </main>
    
    <!-- ================= FORGOT PASSWORD MODAL ================= -->
    
    <div class="forgot-modal-overlay" id="forgotModal">
    
        <div class="forgot-modal">
    
            <button class="forgot-close" id="closeForgotModal">
                ×
            </button>
    
            <div class="forgot-icon">
                🔐
            </div>
    
            <h2>Forgot Password?</h2>
    
            <p class="forgot-text">
                Enter your registered email address.
                We’ll send you a verification OTP.
            </p>
    
            <form action="/forgot-password/send-otp" method="POST">
    
                <div class="forgot-form-group">
    
                    <label for="forgotEmail">
                        Email Address
                    </label>
    
                    <input type="email" id="forgotEmail" name="email" placeholder="Enter your registered email" required>
    
                </div>
    
                <!-- SPACE FOR ERROR / SUCCESS MESSAGE -->
                <% if(typeof otpSended !=="undefined" && !otpSended) { %>
                    <p class="forgot-message"><%= otpSendedMsg %></p>
                <% } %>
                <button type="submit" class="forgot-send-button" >
                    Send OTP
                </button>
    
            </form>
    
            <button type="button" class="forgot-back-button" id="cancelForgotModal">
                Back to Login
            </button>
    
        </div>

        <div class="verify-otp-box">
        
            <div class="forgot-icon">
                🔢
            </div>
            <% if(typeof otpSended !== "undefined" && otpSended) { %>
                <p class="receive-message"><%= otpSendedMsg %></p>
            <% } %>    
            <h2>Verify OTP</h2>
        
            <p class="forgot-text">
                Enter the 6-digit verification code sent to your email.
            </p>
        
            <form action="/forgot-password/verify-otp" method="POST">
        
                <div class="forgot-form-group">
        
                    <label for="otp">
                        Verification Code
                    </label>
        
                    <input type="text" id="otp" name="otp" maxlength="6" placeholder="Enter 6-digit OTP" required>
        
                </div>
                <% if (typeof otpError !== "undefined" && otpError) { %>
                    <p class="forgot-message"><%= errorMsg %></p>
                <% } %>
                <button type="submit" class="forgot-send-button">
                    Verify OTP
                </button>
        
            </form>
        
        
            <div class="otp-bottom">
        
                <span>
                    Didn't receive the code?
                </span>
        
                <form action="/forgot-password/resend-otp" method="POST">
        
                    <button type="submit" class="resend-otp-button">
                        Resend OTP
                    </button>
        
                </form>
        
            </div>
        
        </div>
        
        <!-- ================= RESET PASSWORD BOX ================= -->
        
        <div class="reset-password-box">
        
            <div class="forgot-icon">
                🔐
            </div>
        
            <h2>Create New Password</h2>
        
            <p class="forgot-text">
                Your email has been verified successfully.
                Create a new password for your CareerConnect account.
            </p>
        
            <form action="/forgot-password/reset-password" method="POST">
        
                <div class="forgot-form-group">
        
                    <label for="newPassword">
                        New Password
                    </label>
        
                    <input type="password" id="newPassword" name="newPassword" placeholder="Enter your new password" required>
        
                </div>
        
        
                <div class="forgot-form-group">
        
                    <label for="confirmPassword">
                        Confirm New Password
                    </label>
        
                    <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Re-enter your new password"
                        required>
        
                </div>
        
        
                <!-- SPACE FOR ERROR MESSAGE -->
                <% if (typeof resetError !== "undefined" && resetError ) { %>
                    <p class="reset-password-message"><%= resetErrormsg %></p>
                <% } %>
        
                <button type="submit" class="forgot-send-button">
                    Reset Password
                </button>
        
            </form>
        
        </div>

    </div>

    <!-- ==================== FOOTER ==================== -->
    <% if(typeof otpError !== "undefined" && otpError){ %>
        <script>
            document.getElementById("forgotModal").classList.add("active");
            document.querySelector(".forgot-modal").classList.add("inactive");
            document.querySelector(".verify-otp-box").classList.add("active")
        </script>
    <% } %>
    <% if (typeof otpVerified !== "undefined" && otpVerified) { %>
        <script>
            document.getElementById("forgotModal").classList.add("active");
            document.querySelector(".forgot-modal").classList.add("inactive");
            document.querySelector(".reset-password-box").classList.add("active");
        </script>
    <% } %>
    <% if (typeof resetError !== "undefined" && resetError ) { %>
        <script>
            document.getElementById("forgotModal").classList.add("active");
            document.querySelector(".forgot-modal").classList.add("inactive");
            document.querySelector(".reset-password-box").classList.add("active");
        </script>
    <% } %>   
    <% if(typeof otpSended !=="undefined" && otpSended){ %>
        <script>
            document.getElementById("forgotModal").classList.add("active")
            document.querySelector(".forgot-modal").classList.add("inactive");
            document.querySelector(".verify-otp-box").classList.add("active");
        </script>    
    <% } %>
    
    <% if(typeof otpSended !=="undefined" && !otpSended) { %>
        <script>
            document.getElementById("forgotModal").classList.add("active");
        </script>
    <% } %>
    <script>
        
        const model=document.getElementById("forgotModal");
        const forgorBtn=document.getElementById("openForgotModal");
        const cancelBtn=document.querySelector(".forgot-back-button")

        const verifyOtp=document.querySelector(".verify-otp-box");
        const modelEMail=document.querySelector(".forgot-modal")
        
        forgorBtn.addEventListener("click",()=>{
            model.classList.add("active");
        })

        cancelBtn.addEventListener("click",()=>{
            cancelBtn.classList.remove("active");
        })
        
        submitEmail.addEventListener("click",()=>{
            modelEMail.classList.add("inactive")
            verifyOtp.classList.add("active");
        })
    </script>

</body>

</html>