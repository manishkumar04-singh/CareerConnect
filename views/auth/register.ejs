<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Register | CareerConnect</title>

    <!-- Main CSS -->
    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <!-- Authentication CSS -->
    <link
        rel="stylesheet"
        href="/css/auth.css"
    >

</head>

<body>

    <!-- ==================== NAVBAR ==================== -->

    <%- include("../partials/navbar") %>


    <!-- ==================== REGISTER SECTION ==================== -->

    <main class="auth-page">

        <div class="auth-container">


            <!-- ==================== LEFT SIDE ==================== -->

            <section class="auth-intro">

                <div class="auth-intro-content">

                    <div class="auth-brand">
                        Career<span>Connect</span>
                    </div>

                    <span class="auth-label">
                        JOIN CAREERCONNECT
                    </span>

                    <h1>
                        Build your
                        <span>future</span>
                        with us.
                    </h1>

                    <p>
                        Create your account and start
                        discovering opportunities that
                        can shape your career.
                    </p>


                    <!-- BENEFITS -->

                    <div class="auth-benefits">

                        <div class="benefit-item">

                            <div class="benefit-icon">
                                ✓
                            </div>

                            <div>

                                <strong>
                                    Discover Opportunities
                                </strong>

                                <p>
                                    Find jobs and internships
                                    that match your skills.
                                </p>

                            </div>

                        </div>


                        <div class="benefit-item">

                            <div class="benefit-icon">
                                ✓
                            </div>

                            <div>

                                <strong>
                                    Connect with Recruiters
                                </strong>

                                <p>
                                    Build meaningful connections
                                    with potential employers.
                                </p>

                            </div>

                        </div>


                        <div class="benefit-item">

                            <div class="benefit-icon">
                                ✓
                            </div>

                            <div>

                                <strong>
                                    Grow Your Career
                                </strong>

                                <p>
                                    Take the next step toward
                                    your professional goals.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </section>


            <!-- ==================== RIGHT SIDE ==================== -->

            <section class="auth-form-section">

                <div class="auth-form-container">


                    <!-- FORM HEADING -->

                    <div class="form-heading">

                        <h2>
                            Create Account
                        </h2>

                        <p>
                            Join CareerConnect today
                        </p>

                    </div>

                    <%  if (typeod emailDuplicate !== "undefined" && emailDuplicate) { %>
                        <p class="forgot-message1" > <%= Msg %></p> 
                    <% } %>    
                    <!-- REGISTER FORM -->

                    <form
                        class="auth-form register-form"
                        action="/register"
                        method="POST"
                    >


                        <!-- FULL NAME -->

                        <div class="form-group">

                            <label for="name">
                                Full Name
                            </label>

                            <input
                                type="text"
                                id="name"
                                name="name"
                                placeholder="Enter your full name"
                                autocomplete="name"
                                required
                            >

                        </div>


                        <!-- EMAIL -->

                        <div class="form-group">

                            <label for="email">
                                Email Address
                            </label>

                            <input
                                type="email"
                                id="email"
                                name="email"    
                                placeholder="Enter your email"
                                autocomplete="email"
                                required
                            >

                        </div>


                        <!-- PASSWORD -->

                        <div class="form-group">

                            <label for="password">
                                Password
                            </label>

                            <input
                                type="password"
                                id="password"
                                name="password"
                                placeholder="Create a password"
                                autocomplete="new-password"
                                required
                            >

                        </div>


                        <!-- CONFIRM PASSWORD -->

                        <div class="form-group">

                            <label for="confirmPassword">
                                Confirm Password
                            </label>

                            <input
                                type="password"
                                id="confirmPassword"
                                name="confirmPassword"
                                placeholder="Confirm your password"
                                autocomplete="new-password"
                                required
                            >

                        </div>


                        <!-- ACCOUNT TYPE -->

                        <div class="form-group">

                            <label for="accountType">
                                Account Type
                            </label>

                            <select
                                id="accountType"
                                name="accountType"
                                required
                            >

                                <option
                                    value=""
                                    disabled
                                    selected
                                >
                                    Select account type
                                </option>

                                <option value="student">
                                    Student
                                </option>

                                <option value="recruiter">
                                    Recruiter
                                </option>

                            </select>

                        </div>


                        <!-- TERMS -->

                        <div class="terms-row">

                            <label class="checkbox-container">

                                <input
                                    type="checkbox"
                                    name="terms"
                                    required
                                >

                                <span>
                                    I agree to the
                                    <a href="#">
                                        Terms & Conditions
                                    </a>
                                </span>

                            </label>

                        </div>


                        <!-- CREATE ACCOUNT BUTTON -->

                        <button
                            type="submit"
                            class="auth-submit-btn"
                        >

                            Create Account

                            <span>
                                →
                            </span>

                        </button>


                    </form>


                    <!-- LOGIN LINK -->

                    <div class="auth-switch">

                        <p>

                            Already have an account?

                            <a href="/login">
                                Sign In
                            </a>

                        </p>

                    </div>


                    <!-- DIVIDER -->

                    <div class="auth-divider">

                        <span>
                            Secure Career Platform
                        </span>

                    </div>

                </div>

            </section>

        </div>

    </main>


    <!-- ==================== FOOTER ==================== -->

    <%- include("../partials/footer") %>


</body>

</html>